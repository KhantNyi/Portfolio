---
// One small diagram per challenge. Each explains the idea in the sentence
// beneath it, and animates when its card lands (see the .art-* rules in
// global.css). Colours: currentColor is the card's ink, var(--pa) its paper.
import type { GraphicName } from '../data/site';

interface Props {
  name: GraphicName;
}
const { name } = Astro.props;

const plates = [14, 58, 102, 146, 190].map((x, i) => ({ x, sharp: [1, 3, 4].includes(i), i }));
const votes = [22, 48, 74, 100].map((x, i) => ({ x, i }));
const ticks = [92, 132, 172, 212].map((x, i) => ({ x, i }));
// A torii gate on an 8px grid: [column, row, width, height] in cells.
const torii = [
  [0, 0, 11, 1],
  [1, 1, 9, 1],
  [2, 2, 1, 1],
  [5, 2, 1, 1],
  [8, 2, 1, 1],
  [1, 3, 9, 1],
  [2, 4, 1, 6],
  [8, 4, 1, 6],
];
---

<svg
  class="graphic"
  viewBox="0 0 240 120"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* Athone Sayate: the browser reaches the database only through a lock, and sees only its own rows */}
  {
    name === 'rls' && (
      <>
        <rect class="art-draw" pathLength="1" x="10" y="34" width="64" height="52" rx="6" />
        <path d="M10 46h64" />
        <path class="art-draw" pathLength="1" style="--n:3" d="M82 60h72M148 54l6 6-6 6" />
        <g class="art-pop" style="--n:7">
          <circle cx="117" cy="60" r="14" fill="currentColor" stroke="none" />
          <rect class="g-inv" x="110.5" y="58.5" width="13" height="9.5" rx="2" stroke="none" />
          <path class="g-inv-stroke" d="M113.5 58.5v-3a3.5 3.5 0 0 1 7 0v3" />
        </g>
        <path
          class="art-show"
          style="--n:10"
          d="M170 52c0 4.400 11.600 8 26 8s26-3.600 26-8v16c0 4.400-11.600 8-26 8s-26-3.600-26-8z"
          fill="currentColor"
          fill-opacity="0.28"
          stroke="none"
        />
        <ellipse class="art-draw" pathLength="1" style="--n:5" cx="196" cy="36" rx="26" ry="8" />
        <path class="art-draw" pathLength="1" style="--n:5" d="M170 36v48c0 4.400 11.600 8 26 8s26-3.600 26-8V36" />
        <path d="M170 52c0 4.400 11.600 8 26 8s26-3.600 26-8M170 68c0 4.400 11.600 8 26 8s26-3.600 26-8" />
      </>
    )
  }

  {/* Athone Sayate: writes wait on the phone, then travel to the cloud in order */}
  {
    name === 'queue' && (
      <>
        <rect class="art-draw" pathLength="1" x="14" y="12" width="52" height="96" rx="8" />
        <path d="M34 21h12" />
        {[40, 56, 72].map((y, i) => (
          <rect class="art-pop" style={`--n:${i * 2}`} x="22" y={y} width="36" height="10" rx="3" fill="currentColor" stroke="none" />
        ))}
        <path class="art-show" style="--n:8" d="M76 60h70" stroke-dasharray="4 6" />
        <rect class="g-travel" x="92" y="55" width="18" height="10" rx="3" fill="currentColor" stroke="none" />
        <path
          class="art-draw"
          pathLength="1"
          style="--n:6"
          d="M170 80h40a15 15 0 0 0 2-29.800A19 19 0 0 0 175 48a16 16 0 0 0-5 32z"
        />
      </>
    )
  }

  {/* Athone Sayate: the solid line is what you spent, the dashed line where the month will land */}
  {
    name === 'forecast' && (
      <>
        <path d="M16 14v90h212" />
        <path class="art-show" style="--n:9" d="M104 62L224 12v32z" fill="currentColor" fill-opacity="0.16" stroke="none" />
        <path class="art-draw" pathLength="1" d="M16 92l22-10 20 4 22-18 24-6" stroke-width="2" />
        <path class="art-show" style="--n:8" d="M104 62L224 27" stroke-dasharray="5 5" />
        <circle class="art-pop" style="--n:6" cx="104" cy="62" r="4.5" fill="currentColor" stroke="none" />
        <text class="g-text art-show" style="--n:9" x="104" y="82" text-anchor="middle">TODAY</text>
      </>
    )
  }

  {/* SafeRide: a rider who is tiny in the full frame is cropped and checked again up close */}
  {
    name === 'crop' && (
      <>
        <rect class="art-draw" pathLength="1" x="10" y="18" width="104" height="84" rx="4" />
        <rect x="72" y="58" width="14" height="18" />
        <path class="art-show" style="--n:5" d="M86 58l64-38M86 76l64 24" stroke-dasharray="3 4" />
        <rect class="art-draw" pathLength="1" style="--n:6" x="150" y="20" width="80" height="80" rx="4" stroke-width="2" />
        <g class="art-pop" style="--n:11">
          <circle cx="190" cy="48" r="9" fill="currentColor" stroke="none" />
          <path d="M172 92c0-16 8-27 18-27s18 11 18 27z" fill="currentColor" stroke="none" />
        </g>
        <path class="art-show" style="--n:14" d="M177 47a13 13 0 0 1 26 0" stroke-dasharray="3 3.500" />
      </>
    )
  }

  {/* SafeRide: many plate crops over six seconds, only the sharpest three are read */}
  {
    name === 'plates' && (
      <>
        <path d="M14 96h212M14 92v8M226 92v8" />
        {plates.map((p) =>
          p.sharp ? (
            <g class="art-pop" style={`--n:${p.i * 2 + 2}`}>
              <rect x={p.x} y="46" width="34" height="22" rx="3" stroke-width="2" />
              <path d={`M${p.x + 7} 57h20`} />
              <path d={`M${p.x + 11} 32l4 4 8-9`} stroke-width="2" />
            </g>
          ) : (
            <rect class="art-show" style={`--n:${p.i * 2}`} x={p.x} y="46" width="34" height="22" rx="3" fill="currentColor" fill-opacity="0.2" stroke="none" />
          ),
        )}
        <text class="g-text" x="120" y="113" text-anchor="middle">6 SECONDS</text>
      </>
    )
  }

  {/* SafeRide: several agreeing votes are needed before a violation is recorded */}
  {
    name === 'votes' && (
      <>
        {votes.map((v) => (
          <g class="art-pop" style={`--n:${v.i * 2}`}>
            <circle cx={v.x} cy="60" r="10" fill="currentColor" stroke="none" />
            <path class="g-inv-stroke" d={`M${v.x - 4.5} 60l3 3.500 6-7`} stroke-width="2" />
          </g>
        ))}
        <circle cx="126" cy="60" r="10" stroke-dasharray="3 3.500" />
        <path class="art-draw" pathLength="1" style="--n:9" d="M146 60h24M164 54l6 6-6 6" />
        <path class="art-draw" pathLength="1" style="--n:11" d="M205 32l22 8v18c0 14-9 24-22 28-13-4-22-14-22-28V40z" stroke-width="2" />
        <path class="art-draw" pathLength="1" style="--n:16" d="M195 60l7 7 12-13" stroke-width="2" />
      </>
    )
  }

  {/* Dotesy: the browser is turned away; only a database function may open the wallet */}
  {
    name === 'wallet' && (
      <>
        <rect x="8" y="42" width="50" height="36" rx="5" />
        <path d="M8 52h50" />
        <path class="art-draw" pathLength="1" style="--n:2" d="M62 60h14" />
        <path class="art-draw art-strike" pathLength="1" style="--n:5" d="M79 53l9 14M88 53l-9 14" stroke-width="2.500" />
        <rect class="art-draw" pathLength="1" x="94" y="30" width="56" height="60" rx="8" stroke-width="2" />
        <rect x="111" y="58" width="22" height="17" rx="3" fill="currentColor" stroke="none" />
        <path d="M115.500 58v-5.500a6.500 6.500 0 0 1 13 0V58" stroke-width="2" />
        <g class="art-pop" style="--n:8">
          <rect x="184" y="44" width="50" height="32" rx="5" fill="currentColor" stroke="none" />
          <text class="g-text g-inv" x="209" y="64" text-anchor="middle">RPC()</text>
        </g>
        <path class="art-draw" pathLength="1" style="--n:12" d="M180 60h-24M162 54l-6 6 6 6" />
      </>
    )
  }

  {/* Dotesy: the price you saw is stale; the server shows the new one and asks */}
  {
    name === 'odds' && (
      <>
        <text class="g-price" x="52" y="71" text-anchor="middle" fill="currentColor" stroke="none">1.85</text>
        <path class="art-draw art-strike" pathLength="1" style="--n:3" d="M18 62h68" stroke-width="2.500" />
        <path class="art-draw" pathLength="1" style="--n:6" d="M100 60h26M120 54l6 6-6 6" />
        <g class="art-pop" style="--n:9">
          <rect x="140" y="36" width="88" height="48" rx="9" fill="currentColor" stroke="none" />
          <text class="g-price g-inv" x="184" y="71" text-anchor="middle" stroke="none">1.72</text>
        </g>
        <text class="g-text art-show" style="--n:14" x="184" y="104" text-anchor="middle">CONFIRM?</text>
      </>
    )
  }

  {/* Dotesy: no server waiting around; a job wakes up on a schedule and settles everything */}
  {
    name === 'cron' && (
      <>
        <circle class="art-draw" pathLength="1" cx="36" cy="60" r="22" stroke-width="2" />
        <path class="art-draw" pathLength="1" style="--n:4" d="M36 46v14l9 6" stroke-width="2" />
        <path class="art-draw" pathLength="1" style="--n:5" d="M66 60h164" />
        {ticks.map((t) => (
          <>
            <circle class="art-pop" style={`--n:${t.i * 3 + 7}`} cx={t.x} cy="60" r="5.500" fill="currentColor" stroke="none" />
            <path class="art-draw" pathLength="1" style={`--n:${t.i * 3 + 9}`} d={`M${t.x - 5} 40l3.500 3.500 6-7`} stroke-width="2" />
          </>
        ))}
        <text class="g-text" x="152" y="88" text-anchor="middle">EVERY 10 MIN</text>
      </>
    )
  }

  {/* Tabi: code on the left becomes pixels on the right, with no image file in between */}
  {
    name === 'pixels' && (
      <>
        <text class="g-brace" x="44" y="78" text-anchor="middle" fill="currentColor" stroke="none">{'{ }'}</text>
        <path class="art-draw" pathLength="1" style="--n:2" d="M84 60h26M104 54l6 6-6 6" />
        {torii.map(([c, r, w, h], i) => (
          <rect class="art-pop" style={`--n:${i * 2 + 4}`} x={128 + c * 8} y={20 + r * 8} width={w * 8} height={h * 8} fill="currentColor" stroke="none" />
        ))}
      </>
    )
  }

  {/* Tabi: a square wave from an oscillator becomes the soundtrack */}
  {
    name === 'synth' && (
      <>
        <path class="art-draw g-wave" pathLength="1" d="M12 78h18V44h20v34h20V44h20v34h20V44h20v34h14" stroke-width="2" />
        <g class="art-pop" style="--n:10">
          <ellipse cx="178" cy="84" rx="8" ry="6" fill="currentColor" stroke="none" />
          <path d="M186 84V44l16 6" stroke-width="2" />
        </g>
        <g class="art-pop" style="--n:13">
          <ellipse cx="212" cy="70" rx="8" ry="6" fill="currentColor" stroke="none" />
          <path d="M220 70V30l12 5" stroke-width="2" />
        </g>
      </>
    )
  }

  {/* Tabi: the HTML file goes straight to the browser, nothing in between */}
  {
    name === 'nobuild' && (
      <>
        <path class="art-draw" pathLength="1" d="M16 18h32l16 16v68H16z" />
        <path d="M48 18v16h16" />
        <text class="g-text" x="40" y="74" text-anchor="middle">HTML</text>
        <path class="art-draw" pathLength="1" style="--n:4" d="M76 60h44M114 54l6 6-6 6" />
        <text class="g-text art-show" style="--n:8" x="98" y="46" text-anchor="middle">NO BUILD</text>
        <rect class="art-draw" pathLength="1" style="--n:6" x="132" y="24" width="96" height="72" rx="8" stroke-width="2" />
        <path d="M132 40h96" />
        <path class="art-pop" style="--n:12" d="M170 54l22 13-22 13z" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>
