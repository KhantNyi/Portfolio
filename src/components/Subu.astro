        <circle cx="74" cy="66" r="4" fill="#7A2E1C"></circle>
      </g>
    </g>
    <path d="M52 81Q60 89 68 81" fill="none" stroke="#7A2E1C" stroke-width="3.5" stroke-linecap="round"></path>
  </g>
