---
// The drawing on each Problem card. Each one tells the problem without words
// and animates when its card lands (see the .art rules in global.css).
interface Props {
  name: 'calendar' | 'plate' | 'coins' | 'wander';
}
const { name } = Astro.props;

// calendar: four weeks of days; logging stops after day ten.
const days = Array.from({ length: 28 }, (_, i) => ({
  x: 32 + (i % 7) * 36,
  y: 44 + Math.floor(i / 7) * 38,
  logged: i < 10,
  i,
}));
---

{
  name === 'calendar' && (
    <svg class="art art-calendar" viewBox="0 0 280 200" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      {days.map((d) =>
        d.logged ? (
          <circle class="art-pop" style={`--n:${d.i}`} cx={d.x} cy={d.y} r="10" fill="currentColor" stroke="none" />
        ) : (
          <circle class="art-fade" style={`--n:${d.i}`} cx={d.x} cy={d.y} r="10" stroke-dasharray="3 4" />
        ),
      )}
      <path class="art-draw" pathLength="1" d="M135 77l10 10M145 77l-10 10" stroke-width="2" stroke-linecap="round" style="--n:12" />
    </svg>
  )
}

{
  name === 'plate' && (
    <svg class="art art-plate" viewBox="0 0 280 200" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <g class="art-streaks">
        <path d="M8 64h52" />
        <path d="M24 88h44" />
        <path d="M4 112h60" />
        <path d="M28 136h36" />
      </g>
      <g class="art-shake">
        <rect class="art-draw" pathLength="1" x="92" y="56" width="168" height="88" rx="12" stroke-width="2" />
        <g fill="currentColor" stroke="none" opacity="0.2">
          <rect x="110" y="76" width="52" height="16" rx="8" />
          <rect x="170" y="76" width="72" height="16" rx="8" />
          <rect x="110" y="108" width="132" height="16" rx="8" />
        </g>
        <text class="art-mark" x="176" y="121" text-anchor="middle" fill="currentColor" stroke="none">?</text>
      </g>
    </svg>
  )
}

{
  name === 'wander' && (
    <svg class="art art-wander" viewBox="0 0 280 200" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle class="art-draw" pathLength="1" cx="72" cy="108" r="44" />
      <path d="M64 56h16M72 56v8" />
      <path class="art-draw" pathLength="1" style="--n:3" d="M72 108V80" />
      <path class="art-draw art-strike" pathLength="1" style="--n:5" d="M32 148L112 68" stroke-width="3" />
      <path class="art-draw" pathLength="1" style="--n:8" d="M132 104h20M146 97l7 7-7 7" />
      <path class="art-show" style="--n:11" d="M178 152c8-34 42-12 38-44s28-22 42-52" stroke-dasharray="4 7" />
      <circle class="art-pop" style="--n:11" cx="178" cy="152" r="6" fill="currentColor" stroke="none" />
      <circle class="art-pop" style="--n:16" cx="258" cy="56" r="8" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  name === 'coins' && (
    <svg class="art art-coins" viewBox="0 0 280 200" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle class="art-draw" pathLength="1" cx="72" cy="100" r="46" />
      <text class="art-mark" x="72" y="118" text-anchor="middle" fill="currentColor" stroke="none">$</text>
      <path class="art-draw art-strike" pathLength="1" d="M34 138L110 62" stroke-width="3" />
      <path class="art-draw" pathLength="1" d="M132 100h20M146 93l7 7-7 7" style="--n:6" />
      <g class="art-pop" style="--n:9">
        <circle cx="210" cy="100" r="46" fill="currentColor" stroke="none" />
        <path
          class="art-star"
          d="M210 72l8.2 17 18.6 2.5-13.6 13 3.4 18.5-16.6-9-16.6 9 3.4-18.5-13.6-13 18.6-2.5z"
          stroke="none"
        />
      </g>
    </svg>
  )
}
