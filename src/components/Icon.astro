---
// Small line icons. Every shape gets pathLength="1" so CSS can draw it on.
import type { IconName } from '../data/site';

interface Props {
  name: IconName;
}
const { name } = Astro.props;

const shapes: Record<IconName, string> = {
  tap: '<circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="7.5"/><path d="M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2"/>',
  chart: '<path d="M3 20h18"/><path d="M4 15l5-5 4 3 7-8"/><path d="M16 5h4v4"/>',
  bell: '<path d="M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2.2 2.2 0 0 0 4 0"/>',
  video: '<rect x="2.5" y="6" width="13" height="12" rx="2"/><path d="M15.5 10.5l6-3v9l-6-3z"/>',
  scan: '<path d="M3 8V4h4"/><path d="M17 4h4v4"/><path d="M21 16v4h-4"/><path d="M7 20H3v-4"/><circle cx="12" cy="12" r="3.5"/>',
  plate: '<rect x="2.5" y="7" width="19" height="10" rx="2"/><path d="M6.5 12h3"/><path d="M12 12h5.5"/>',
  coin: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5l1.4 2.9 3.1.4-2.3 2.2.6 3.1-2.8-1.5-2.8 1.5.6-3.1-2.3-2.2 3.1-.4z"/>',
  versus: '<circle cx="8" cy="12" r="5.5"/><circle cx="16" cy="12" r="5.5"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5V17"/>',
  offline: '<path d="M2.5 9a14 14 0 0 1 19 0"/><path d="M6 12.5a9 9 0 0 1 12 0"/><path d="M9.5 16a4 4 0 0 1 5 0"/><path d="M4 3l16 18"/>',
  forecast: '<path d="M3 21h18"/><path d="M3 17l4-4 3 2 3-4"/><path d="M13 11l8-7"/><path d="M17 4h4v4"/>',
  zoom: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/><path d="M10.5 8v5M8 10.5h5"/>',
  layers: '<path d="M12 3l9 4.5-9 4.5-9-4.5z"/><path d="M3 12l9 4.5 9-4.5"/><path d="M3 16.5L12 21l9-4.5"/>',
  shield: '<path d="M12 2.5l8 3v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10v-6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  wallet: '<rect x="2.5" y="6" width="19" height="13" rx="2.5"/><path d="M5 6V5a1.5 1.5 0 0 1 1.5-1.5H17"/><path d="M15.5 12.5h6"/>',
  updown: '<path d="M7 20V5"/><path d="M3.5 8.5L7 5l3.5 3.5"/><path d="M17 4v15"/><path d="M13.5 15.5L17 19l3.5-3.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  train: '<rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 11h14"/><path d="M9 14.2v.1M15 14.2v.1"/><path d="M8 17l-2 4"/><path d="M16 17l2 4"/>',
  door: '<path d="M5 21V4.5A1.5 1.5 0 0 1 6.5 3h11A1.5 1.5 0 0 1 19 4.5V21"/><path d="M3 21h18"/><path d="M15 12v1.5"/>',
  stamp: '<path d="M9.5 3.5h5V8l2 4.500h-9L9.500 8z"/><rect x="5" y="12.5" width="14" height="4" rx="1"/><path d="M5 20.500h14"/>',
};

const html = shapes[name].replace(/<(path|circle|rect)/g, '<$1 pathLength="1"');
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={html}
/>
